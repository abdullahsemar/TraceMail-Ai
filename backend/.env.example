# ==============================================================================
# TRACEMAIL AI - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)
# 2. Update the configuration keys below with your local environment values.
# 3. DO NOT commit your live .env file to version control.
# ==============================================================================

# --- System & Deployment Mode ---
# Modes: "gmail" (Mailbox Post-Delivery Monitoring) | "smtp_gateway" (Pre-Delivery Enterprise Proxy) | "hybrid"
TRACEMAIL_DEPLOYMENT_MODE=hybrid
ENV=development
DEBUG=true

# --- Database ---
DATABASE_URL=sqlite:///./tracemail.db

# --- Security & Session Authentication ---
SECRET_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_SECRET_KEY_IN_PRODUCTION
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Storage & Evidence Preservation ---
EVIDENCE_DIR=./evidence_storage
REPORTS_DIR=./reports
CONFIG_DIR=./config
STORE_RAW_EMAIL=true
RAW_EMAIL_RETENTION_DAYS=90
MASK_SENSITIVE_DATA=false

# --- Pre-Delivery Inbound SMTP Gateway ---
SMTP_GATEWAY_ENABLED=true
SMTP_GATEWAY_HOST=127.0.0.1
SMTP_GATEWAY_PORT=1025

# --- Downstream Mail Transfer Agent (MTA) Relay ---
# Destination mailbox server to receive verified clean mail (e.g. Exchange, Postfix, Zimbra)
DOWNSTREAM_SMTP_HOST=127.0.0.1
DOWNSTREAM_SMTP_PORT=1026
DOWNSTREAM_SMTP_USE_TLS=false
DOWNSTREAM_SMTP_STARTTLS=false
DOWNSTREAM_SMTP_USERNAME=
DOWNSTREAM_SMTP_PASSWORD=

# --- Subject Warning Prefix ---
TRACEMAIL_SUBJECT_WARNING_ENABLED=false

# --- Policy & Detection Thresholds ---
SENTINEL_FAST_ALLOW_THRESHOLD=20
SENTINEL_DEEP_SCAN_THRESHOLD=40
FUSION_FLAG_ALERT_THRESHOLD=60
FUSION_FLAG_THRESHOLD=30
CAMPAIGN_SIMILARITY_REVIEW=0.70
CAMPAIGN_SIMILARITY_STRONG=0.85

# --- Google Workspace / Gmail OAuth Connector ---
# Create credentials in Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/connectors/gmail/callback
GOOGLE_OAUTH_LOCAL_CONFIG=./config/google_oauth.local.json
GOOGLE_TOKENS_STORAGE=./config/google_tokens.json
GMAIL_INITIAL_SYNC_LIMIT=25

# --- Telegram Real-Time Incident Alerts ---
# Obtain token from @BotFather, get Chat ID via @userinfobot
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_MIN_SEVERITY=HIGH
PUBLIC_DASHBOARD_URL=http://localhost:5173

# --- Observable Infrastructure & Threat Intelligence ---
# Optional path to local MaxMind GeoLite2-City.mmdb database
MAXMIND_DB_PATH=

# --- Machine Learning / DistilBERT Phishing Classifier ---
ENABLE_DISTILBERT_DOWNLOAD=false
DISTILBERT_MODEL_NAME=spotproject/spot-distilbert-phishing

# --- Background Retrospective Scanning ---
RETROSPECTIVE_SCAN_INTERVAL_SECONDS=3600

# --- Frontend & CORS ---
FRONTEND_URL=http://localhost:5173
